#!/usr/bin/bash

RED=$'\e[31m'
GREEN=$'\e[32m'
ORANGE=$'\e[33m'
CYAN=$'\e[96m'
RESET=$'\e[0m'
BLINK=$'\e[5m'

draw() {
    line="-------------------"
    echo +${line}+
    for i in {0..3}; do
        cur="|"
        for j in {0..3}; do
            pos=$((i*4+j))
            cur+=" "
            case "${board[$pos]}" in
                [1-9])
                    cur+=" ${board[$pos]}"
                ;;
                0)
                    cur+="  "
                ;;
                *)
                    cur+="${board[$pos]}"
                ;;
            esac
            cur+=" |"
        done
        echo "$cur"
        if [[ $i < 3 ]]; then echo \|${line}\|; fi
    done
    echo +${line}+
}

#region init
board=()
for i in {1..15}; do board+=("$i"); done
board+=("0")

for i in {15..1}; do
    swap=$((RANDOM%(i+1)))
    tmp=${board[$i]}; board[$i]=${board[$swap]}; board[$swap]=$tmp
    # echo $swap ${board[@]}
done
# declare -p board

declare -i inversions=0
blank=0
for i in {0..15}; do
    if [[ ${board[$i]} == 0 ]]; then blank=$i; continue; fi
    declare -i j=i+1
    while (( j < 16 )); do
        if [[ ${board[$j]} == 0 ]]; then j+=1; continue; fi
        if [[ ${board[$i]} > ${board[$j]} ]]; then inversions+=1; fi
        j+=1
    done
done
blank_row=$((4 - blank/4))
# echo $inversions
# echo $blank_row

if (( (inversions+blank_row)%2 == 0)); then
    a=0; b=2
    if [[ $blank == $a ]]; then a=1; fi
    if [[ $blank == $b ]]; then b=3; fi
    tmp=${board[$a]}; board[$a]=${board[$b]}; board[$b]=$tmp
    echo "Fixed"
fi
#endregion

declare -i step=1
while :; do
    echo "${GREEN}Ход #${step}${RESET}"
    draw

    declare -i top=blank-4 l=blank-1 r=blank+1 bot=blank+4 row=blank/4
    available=()
    if (( 0 <= $top && $top < 16 )); then available+=($top); fi
    if (( 0 <= $l && $l < 16 && $l/4 == $row )); then available+=($l); fi
    if (( 0 <= $r && $r < 16 && $r/4 == $row )); then available+=($r); fi
    if (( 0 <= $bot && $bot < 16 )); then available+=($bot); fi
    # declare -p top l r bot row available

    read -p "${ORANGE}Введите костяшку, чтобы передвинуть (q - для выхода) ${RESET}" u

    swap=$blank
    for a in ${available[@]}; do
        if [[ $u == ${board[$a]} ]]; then swap=$a; fi
    done
    
    if [ $swap == $blank ]; then
        case "$u" in
            [1-9]|1[0-5])
                echo "${RED}Неправильный ход!"
                echo "Невозможно костяшку $u передвинуть на пустую ячейку."
                tmp=""; for a in "${available[@]}"; do tmp+="${board[$a]}, "; done
                echo "Можно выбрать: ${tmp%, }${RESET}"
                continue;
            ;;
            q) echo "${BLINK}${CYAN}Спасибо за игру${RESET}"; exit 1; ;;
            *) echo "${RED}\"${u}\" не является корректным вводом${RESET}"; continue; ;;
        esac
    fi
    # echo $swap $blank
    board[$blank]=${board[$swap]}
    board[$swap]=0
    blank=$swap

    check=true
    for i in {0..14}; do
        if [ ${board[$i]} != $((i+1)) ]; then check=false; break; fi
    done
    if $check; then echo "${GREEN}${BLINK}Поздравляю, вы решили за ${step} шагов!!!${RESET}"; draw; break; fi

    step+=1
done