#!/usr/bin/bash

RED=$'\e[31m'
GREEN=$'\e[32m'
ORANGE=$'\e[33m'
CYAN=$'\e[96m'
RESET=$'\e[0m'
BLINK=$'\e[5m'

is_valid() {
    local s=$1
    if ! [[ ${#s} == 4 && $s =~ [0-9]{4} ]]; then return 1; fi

    for i in {1..3}; do
        if [[ ${s:0:i} == *"${s:i:1}"* ]]; then return 1; fi
    done
}

trap 'echo; echo "${RED}Чтобы выйти введите q или Q.${RESET}";' INT

n=${RANDOM: -4}
while ! is_valid $n; do
    # echo $n
    n=${RANDOM: -4}
done

declare -A history

declare -i step=1
while :; do
    read -p "${GREEN}Ход #${step}. ${ORANGE}Введите 4-х значное число, без повторяющихся цифр (q/Q - для выхода): ${RESET}" u
    if [[ "$u" == "q" || "$u" == "Q" ]]; then echo "${BLINK}${CYAN}Спасибо за игру${RESET}"; exit 1; fi
    if [[ "$u" == "$n" ]]; then echo "${GREEN}${BLINK}Поздравляю, вы угадали за ${step} шагов!!!${RESET}"; break; fi
    if !(is_valid "$u"); then echo "${RED}\"${u}\" не является корректным вводом${RESET}"; continue; fi
    
    declare -i cows=0 bulls=0
    for i in {0..3}; do
        if [[ $n == *"${u:i:1}"* ]]; then cows+=1; fi
        if [[ ${n:i:1} == ${u:i:1} ]]; then bulls+=1; fi
    done

    echo -e "Коров: ${cows}\tБыков: ${bulls}"
    history[${step},0]=$u
    history[${step},1]=$cows
    history[${step},2]=$bulls

    echo
    echo "История ходов:"
    declare -i i=1
    while (( $i <= $step )); do
        echo -e "${i}. ${history[$i,0]}\t(Коров: ${history[$i,1]}\tБыков: ${history[$i,2]})"
        i+=1
    done

    step+=1
    echo $n $u
done

# 1. Сценарий должен сформировать случайное 4-х значное число с неповторяющимися цифрами (загаданное число).
# 2. На каждом шаге сценарий должен запросить у пользователя вариант 4-х значного числа с неповторяющимися цифрами.
# 3. После получение числа от пользователя сценарий должен сообщить пользователю:
#   ◦ Количество «коров». Корова — это цифра из числа пользователя, которая имеется в загаданном числе, но расположена на другой позиции.
#   ◦ Количество «быков». Бык — это цифра из числа пользователя, которая имеется в загаданного числе и расположена на той же позиции.
# 4. На каждом шаге сценарий должен выводить историю ходов, где в каждой строке выводятся номер хода, вариант числа от пользователя и
#    в этой же строке количество коров и быков.
# 5. Если пользователь ввел загаданное число, то сценарий должен сообщить пользователю, что он угадал загаданное число и прекратить
#    работу со статусом завершения (выхода) — 0.
# 6. Если пользователь ввел символ «q» или «Q», то сценарий должен прекратить работу со статусом завершения (выхода) — 1.
# 7. Если пользователь ввел, что-то отличное от 4-х значного число с не повторяющимися цифрами или символов «q» или «Q», то сценарий
#    должен сообщить об ошибке и предложить повторить ввод.
# 8. Если работающий сценарий получил сигнал SIGINT (пользователь нажал на клавиатуре Ctrl + C ), то сценарий должен сообщить пользователю,
#    что завершить работу сценария можно введя символ «q» или «Q» и продолжить свою работу.
